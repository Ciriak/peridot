# Export variables in your shell before running the server or Prisma CLI.
# Environment files are not loaded automatically.
HOST=127.0.0.1
PORT=17430
DATABASE_URL=file:./peridot.db
MUSIC_LIBRARY_PATH=./music
# Comma-separated browser origins allowed to call the API.
PERIDOT_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Required before adding keyed metadata providers such as Discogs.
# Generate 32 random bytes and encode them as base64; keep this key backed up.
PERIDOT_CREDENTIAL_KEY=
