# Export variables in your shell before running the server or Prisma CLI.
# Environment files are not loaded automatically.
HOST=127.0.0.1
PORT=17430
PERIDOT_SERVE_WEB=true
DATABASE_URL=file:./peridot.db
MUSIC_LIBRARY_PATH=./music
# Comma-separated web and desktop origins allowed to call the API.
PERIDOT_WEB_ORIGINS=http://127.0.0.1:17430,http://localhost:17430,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Optional override for keyed metadata provider encryption. When unset, Peridot
# creates and reuses a local key file beside DATABASE_URL, such as peridot.db.key.
PERIDOT_CREDENTIAL_KEY=
