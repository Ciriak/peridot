  {
    "id": "dropColumn.ArtistImage.data",
    "label": "Drop column \"data\" from \"ArtistImage\"",
    "summary": "Drops column data on ArtistImage which is not in the contract",
    "operationClass": "destructive",
    "target": {
      "id": "sqlite",
      "details": {
        "objectType": "column",
        "name": "data",
        "table": "ArtistImage"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"data\" exists on \"ArtistImage\"",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM pragma_table_info(?1) WHERE \"name\" = ?2",
        "params": [
          "ArtistImage",
          "data"
        ],
        "expectation": {
          "expects": "present",
          "object": "column \"data\" on \"ArtistImage\""
        }
      }
    ],
    "execute": [
      {
        "description": "drop column \"data\" from \"ArtistImage\"",
        "sql": "ALTER TABLE \"ArtistImage\" DROP COLUMN \"data\""
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"data\" is gone from \"ArtistImage\"",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM pragma_table_info(?1) WHERE \"name\" = ?2",
        "params": [
          "ArtistImage",
          "data"
        ],
        "expectation": {
          "expects": "absent",
          "object": "column \"data\" on \"ArtistImage\""
        }
      }
    ]
  },
