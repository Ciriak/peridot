    "id": "data_migration.reset-media-type-to-detected",
    "label": "Reset track media types to their detected values",
    "summary": "Discard source and manual overrides before removing classification fields",
    "operationClass": "data",
    "target": {
      "id": "sqlite",
      "details": {
        "objectType": "table",
        "name": "Track"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "Discard source and manual overrides before removing classification fields",
        "sql": "UPDATE \"Track\" SET \"mediaType\" = \"detectedMediaType\", \"mediaTypeOrigin\" = \"detectedMediaTypeOrigin\""
      }
    ],
    "postcheck": []
