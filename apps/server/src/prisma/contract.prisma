// use prisma-8

model User {
  id           String   @id @onCreate(cuid(2))
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String
  bootstrapKey String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())

  @@index([role])
}

model Session {
  id        String   @id @onCreate(cuid(2))
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Track {
  id                         String     @id @onCreate(cuid(2))
  title                      String
  artist                     String
  artistCredits              String?
  album                      String?
  discNumber                 Int?
  trackNumber                Int?
  relativePath               String
  mimeType                   String
  durationMs                 Int?
  fileSizeBytes              BigInt
  fileModifiedAt             DateTime
  metadataVersion            Int        @default(0)
  metadataMode               String     @default("automatic")
  metadataTitle              String?
  metadataArtist             String?
  metadataArtistCredits      String?
  metadataAlbum              String?
  metadataDiscNumber         Int?
  metadataTrackNumber        Int?
  metadataProviderId         String?
  metadataProviderKind       String?
  metadataProviderName       String?
  metadataExternalTrackId    String?
  metadataExternalReleaseId  String?
  metadataSourceUrl          String?
  metadataDetails            String?
  metadataMatchedAt          DateTime?
  metadataAttemptedSignature String?
  coverId                    String?
  available                  Int        @default(1)
  lastSeenScanId             String?
  sourceId                   String?
  source                     Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @onCreate(now()) @onUpdate(now())

  @@unique([sourceId, relativePath])
  @@index([available])
  @@index([artist, album, title])
  @@index([sourceId])
  @@index([coverId])
}

model TrackCover {
  id        String   @id @onCreate(cuid(2))
  hash      String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
}

model TrackLike {
  userId    String
  trackId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
}

model TrackPlayEvent {
  id       String   @id @onCreate(cuid(2))
  userId   String
  trackId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([trackId])
}

model QueueItem {
  userId         String
  trackId        String
  position       Int
  randomPosition Int?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@id([userId, trackId])
  @@index([userId, position])
  @@index([userId, randomPosition])
  @@index([trackId])
}

model QueueState {
  userId         String   @id
  activeTrackId  String?
  shuffleEnabled Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTrack    Track?   @relation(fields: [activeTrackId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @onCreate(now()) @onUpdate(now())

  @@index([activeTrackId])
}

model AlbumLike {
  id               String   @id @onCreate(cuid(2))
  userId           String
  title            String
  artist           String
  normalizedTitle  String
  normalizedArtist String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([userId, normalizedArtist, normalizedTitle])
  @@index([userId, createdAt])
}

model ArtistLike {
  id             String   @id @onCreate(cuid(2))
  userId         String
  name           String
  normalizedName String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
}

model Task {
  id                String    @id @onCreate(cuid(2))
  kind              String
  status            String
  title             String
  parentTaskId      String?
  sourceId          String?
  sourceName        String?
  progressCompleted Int?
  progressTotal     Int?
  details           String    @default("[]")
  failureSummary    String?
  forceRefresh      Int       @default(0)
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  @@index([status, createdAt])
  @@index([kind, status])
  @@index([parentTaskId])
}

model ServerSetting {
  id          String   @id
  libraryRoot String
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())
}

model Source {
  id          String   @id @onCreate(cuid(2))
  kind        String
  name        String?
  path        String?
  url         String?
  integration String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  @@index([kind])
  @@index([position])
}

model MetadataProvider {
  id                   String   @id @onCreate(cuid(2))
  kind                 String   @unique
  name                 String
  accountLabel         String?
  configuration        String   @default("{}")
  credentialCiphertext String?
  enabled              Int      @default(1)
  position             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @onCreate(now()) @onUpdate(now())

  @@index([position])
}
