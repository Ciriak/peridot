// use prisma-8

model User {
  id                    String   @id @onCreate(cuid(2))
  email                 String   @unique
  displayName           String
  normalizedDisplayName String   @unique
  passwordHash          String
  role                  String
  likedTitlesOffline    Int?
  bootstrapKey          String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @onCreate(now()) @onUpdate(now())
  tasks                 Task[]
  playlistAccounts      PlaylistAccount[]

  @@index([role])
}

model Playlist {
  id        String        @id @onCreate(cuid(2))
  userId    String
  kind      String        @default("manual")
  name      String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PlaylistItem[]
  likes     PlaylistLike[]
  link      PlaylistLink?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @onCreate(now()) @onUpdate(now())

  @@index([userId, updatedAt])
}

model PlaylistAccount {
  id                   String         @id @onCreate(cuid(2))
  userId               String
  kind                 String
  name                 String
  configuration        String         @default("{}")
  credentialCiphertext String?
  enabled              Int            @default(1)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  links                PlaylistLink[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @onCreate(now()) @onUpdate(now())

  @@index([userId, kind])
}

model PlaylistLink {
  id                 String          @id @onCreate(cuid(2))
  playlistId         String          @unique
  accountId          String
  externalPlaylistId String
  syncMode           String          @default("import")
  syncCursor         String?
  remoteVersion      String?
  lastSyncedAt       DateTime?
  enabled            Int             @default(1)
  playlist           Playlist        @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  account            PlaylistAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @onCreate(now()) @onUpdate(now())

  @@unique([accountId, externalPlaylistId])
  @@index([accountId])
}

model PlaylistItem {
  id               String     @id @onCreate(cuid(2))
  playlistId       String
  position         Int
  identityKey      String
  mediaId          String?
  externalProvider String?
  externalTrackId  String?
  matchStatus      String     @default("matched")
  snapshotTitle    String
  snapshotArtist   String
  snapshotAlbum    String?
  snapshotDuration Int?
  playlist         Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media            Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @onCreate(now()) @onUpdate(now())

  @@unique([playlistId, identityKey])
  @@index([playlistId, position])
  @@index([mediaId])
  @@index([externalProvider, externalTrackId])
}

model PlaylistLike {
  id         String   @id @onCreate(cuid(2))
  userId     String
  playlistId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, playlistId])
  @@index([userId, createdAt])
  @@index([playlistId])
}

model Session {
  id        String   @id @onCreate(cuid(2))
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @onCreate(cuid(2))
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LibrarySource {
  id                   String       @id @onCreate(cuid(2))
  kind                 String
  name                 String?
  path                 String?
  url                  String?
  sourceIdentity       String?
  configuration        String?
  credentialCiphertext String?
  lastSyncedAt         DateTime?
  position             Int          @default(0)
  removedAt            DateTime?
  copies               MediaCopy[]
  artworkJobs          ArtworkJob[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @onCreate(now()) @onUpdate(now())

  @@index([kind])
  @@index([position])
  @@index([removedAt])
  @@unique([kind, sourceIdentity])
}

model ReleaseIndexer {
  id                   String   @id @onCreate(cuid(2))
  kind                 String   @default("torznab")
  name                 String?
  url                  String
  sourceIdentity       String?
  configuration        String?
  credentialCiphertext String?
  downloadClientId     String?
  position             Int      @default(0)
  removedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @onCreate(now()) @onUpdate(now())

  @@index([position])
  @@index([removedAt])
  @@unique([kind, sourceIdentity])
}

model DownloadClient {
  id                   String   @id @onCreate(cuid(2))
  kind                 String
  name                 String
  url                  String
  username             String
  credentialCiphertext String
  destinationSourceId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @onCreate(now()) @onUpdate(now())
}

model Media {
  id                         String          @id @onCreate(cuid(2))
  mediaType                  String          @default("music")
  mediaTypeOrigin            String          @default("fallback")
  title                      String
  artist                     String
  artistCredits              String?
  albumArtist                String?
  albumArtistCredits         String?
  album                      String?
  genres                     String?
  discNumber                 Int?
  trackNumber                Int?
  durationMs                 Int?
  publishedAt                DateTime?
  metadataVersion            Int             @default(0)
  metadataMode               String          @default("automatic")
  metadataTitle              String?
  metadataArtist             String?
  metadataArtistCredits      String?
  metadataAlbumArtist        String?
  metadataAlbumArtistCredits String?
  metadataAlbum              String?
  metadataGenres             String?
  metadataDiscNumber         Int?
  metadataTrackNumber        Int?
  metadataProviderId         String?
  metadataProviderKind       String?
  metadataProviderName       String?
  metadataExternalTrackId    String?
  metadataExternalReleaseId  String?
  metadataSourceUrl          String?
  metadataDetails            String?
  metadataMatchedAt          DateTime?
  metadataAttemptedSignature String?
  coverId                    String?
  available                  Int             @default(1)
  catalogProjectionPending   Int             @default(0)
  manualOverrides            String          @default("{}")
  copies                     MediaCopy[]
  aliases                    MediaAlias[]
  likes                      MediaLike[]
  playEvents                 MediaPlayEvent[]
  playlistItems              PlaylistItem[]
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @onCreate(now()) @onUpdate(now())

  @@index([available])
  @@index([mediaType])
  @@index([artist, album, title])
  @@index([catalogProjectionPending])
  @@index([coverId])
  @@index([metadataProviderKind, metadataExternalTrackId])
  @@index([updatedAt, id])
}

model MediaCopy {
  id                    String        @id @onCreate(cuid(2))
  mediaId               String
  librarySourceId       String
  relativePath          String
  mediaType             String        @default("music")
  mediaTypeOrigin       String        @default("fallback")
  title                 String
  artist                String
  artistCredits         String?
  albumArtist           String?
  albumArtistCredits    String?
  album                 String?
  genres                String?
  discNumber            Int?
  trackNumber           Int?
  durationMs            Int?
  publishedAt           DateTime?
  mimeType              String
  fileSizeBytes         BigInt
  fileModifiedAt        DateTime
  externalId            String?
  externalVersion       String?
  externalContainer     String?
  externalCoverKey      String?
  recordingIdentityKeys String        @default("[]")
  audioLossless         Int           @default(0)
  audioBitrate          Int?
  coverId               String?
  available             Int           @default(1)
  lastSeenScanId        String?
  metadataVersion       Int           @default(0)
  manualOverrides       String        @default("{}")
  media                 Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  librarySource         LibrarySource @relation(fields: [librarySourceId], references: [id], onDelete: Cascade)
  artworkJob            ArtworkJob?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @onCreate(now()) @onUpdate(now())

  @@unique([librarySourceId, relativePath])
  @@unique([librarySourceId, externalId])
  @@index([mediaId, available])
  @@index([librarySourceId])
  @@index([lastSeenScanId])
  @@index([mimeType])
  @@index([audioLossless, audioBitrate])
  @@index([fileSizeBytes])
}

model MediaAlias {
  id        String   @id @onCreate(cuid(2))
  aliasId   String   @unique
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([mediaId])
}

model Cover {
  id        String   @id @onCreate(cuid(2))
  hash      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
}

model ArtworkJob {
  id                  String        @id @onCreate(cuid(2))
  copyId              String        @unique
  librarySourceId     String
  externalCoverItemId String
  externalCoverTag    String?
  attemptCount        Int           @default(0)
  lastAttemptAt       DateTime?
  copy                MediaCopy     @relation(fields: [copyId], references: [id], onDelete: Cascade)
  librarySource       LibrarySource @relation(fields: [librarySourceId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @onCreate(now()) @onUpdate(now())

  @@index([createdAt])
  @@index([librarySourceId, externalCoverItemId, externalCoverTag], name: "artwork_source_cover")
}

model MediaLike {
  userId    String
  mediaId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, mediaId])
  @@index([mediaId])
}

model MediaPlayEvent {
  id       String   @id @onCreate(cuid(2))
  userId   String
  mediaId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([mediaId])
}

model AlbumLike {
  id        String   @id @onCreate(cuid(2))
  userId    String
  albumId   String
  title     String
  artist    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, albumId])
  @@index([userId, createdAt])
  @@index([albumId])
}

model ArtistLike {
  id             String   @id @onCreate(cuid(2))
  userId         String
  name           String
  normalizedName String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
}

model Task {
  id                String    @id @onCreate(cuid(2))
  kind              String
  status            String
  title             String
  titleMessage      String?
  ownerUserId       String?
  ownerUser         User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  parentTaskId      String?
  connectorId       String?
  connectorKind     String?
  connectorName     String?
  progressCompleted Int?
  progressTotal     Int?
  details           String    @default("[]")
  payload           String?
  failureSummary    String?
  failureMessage    String?
  forceRefresh      Int       @default(0)
  retryCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @onCreate(now()) @onUpdate(now())

  @@index([status, createdAt])
  @@index([kind, status])
  @@index([ownerUserId])
  @@index([parentTaskId])
  @@index([connectorId])
}

model ServerSetting {
  id                   String   @id
  libraryRoot          String
  scanWorkerCount      Int      @default(6)
  sourceRefreshEnabled Int      @default(1)
  sourceRefreshCron    String   @default("0 3 * * *")
  fileLoggingEnabled   Int      @default(1)
  fileLogRetentionDays Int      @default(5)
  updatedAt            DateTime @onCreate(now()) @onUpdate(now())
}

model MetadataProvider {
  id                   String   @id @onCreate(cuid(2))
  kind                 String   @unique
  name                 String
  accountLabel         String?
  configuration        String   @default("{}")
  credentialCiphertext String?
  enabled              Int      @default(1)
  position             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @onCreate(now()) @onUpdate(now())

  @@index([position])
}

model CatalogState {
  id                String   @id
  revision          Int      @default(0)
  projectionVersion Int      @default(0)
  updatedAt         DateTime @onCreate(now()) @onUpdate(now())
}

model CatalogMedia {
  id                 String   @id
  sourceKind         String?
  mediaType          String   @default("music")
  title              String
  artist             String
  artistCredits      String
  albumArtist        String
  albumArtistCredits String
  album              String?
  normalizedTitle    String
  normalizedArtist   String
  normalizedAlbum    String
  normalizedGenres   String   @default("")
  durationMs         Int?
  publishedAt        DateTime?
  discNumber         Int?
  trackNumber        Int?
  releaseYear        Int?
  available          Int
  coverId            String?
  albumId            String?
  albumFolderKey     String
  albumReleaseKey    String?
  updatedAt          DateTime @onCreate(now()) @onUpdate(now())

  @@index([normalizedArtist, normalizedAlbum, normalizedTitle, id], map: "cm_artist_album_title")
  @@index([normalizedArtist, normalizedTitle, id], map: "cm_artist_title")
  @@index([normalizedAlbum, normalizedTitle, id], map: "cm_album_title")
  @@index([normalizedTitle, id], map: "cm_title")
  @@index([durationMs, id], map: "cm_duration")
  @@index([available, id])
  @@index([mediaType, available, id])
  @@index([sourceKind])
  @@index([albumId])
  @@index([albumFolderKey, normalizedAlbum, id])
}

model MediaMatchState {
  id               String   @id
  algorithmVersion Int      @default(0)
  lastCompletedAt  DateTime?
  mergedCount      Int      @default(0)
  groupCount       Int      @default(0)
  updatedAt        DateTime @onCreate(now()) @onUpdate(now())
}

model CatalogAlbum {
  id                  String   @id
  mediaType           String   @default("music")
  title               String
  artist              String
  normalizedTitle     String
  normalizedArtist    String
  artistId            String?
  coverId             String?
  coverMediaId        String?
  artistCredits       String?
  trackCount          Int      @default(0)
  availableTrackCount Int      @default(0)
  durationMs          Int?
  releaseYear         Int?
  latestPublishedAt   DateTime?
  updatedAt           DateTime @onCreate(now()) @onUpdate(now())

  @@index([normalizedTitle, normalizedArtist, id], map: "ca_title_artist")
  @@index([mediaType, normalizedTitle, id])
  @@index([normalizedArtist, normalizedTitle, id], map: "ca_artist_title")
  @@index([artistId, id])
}

model CatalogArtist {
  id                    String   @id
  name                  String
  normalizedName        String
  displayName           String   @default("")
  normalizedDisplayName String   @default("")
  trackCount            Int      @default(0)
  availableTrackCount   Int      @default(0)
  albumCount            Int      @default(0)
  durationMs            Int?
  updatedAt             DateTime @onCreate(now()) @onUpdate(now())

  @@index([normalizedName, id])
  @@index([normalizedDisplayName, id])
}

model ArtistImage {
  id        String           @id @onCreate(cuid(2))
  hash      String           @unique
  sourceUrl String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @onCreate(now()) @onUpdate(now())
  metadata  ArtistMetadata[]
}

model ArtistMetadata {
  artistId               String        @id
  displayName            String
  metadataMode           String        @default("automatic")
  nameProviderId         String?
  nameProviderKind       String?
  nameProviderName       String?
  externalArtistId       String?
  nameSourceUrl          String?
  imageId                String?
  image                  ArtistImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageProviderId        String?
  imageProviderKind      String?
  imageProviderName      String?
  imageExternalArtistId  String?
  imageSourceUrl         String?
  matchedAt              DateTime?
  attemptedSignature     String?
  updatedAt              DateTime      @onCreate(now()) @onUpdate(now())

  @@index([imageId])
}

model CatalogMediaArtist {
  id       String @id @onCreate(cuid(2))
  mediaId  String
  artistId String

  @@unique([mediaId, artistId])
  @@index([artistId, mediaId])
}

model CatalogArtistAlbum {
  id         String @id @onCreate(cuid(2))
  artistId   String
  albumId    String
  trackCount Int    @default(0)

  @@unique([artistId, albumId])
  @@index([albumId, artistId])
}

model CatalogSearchTerm {
  id         String @id @onCreate(cuid(2))
  entityType String
  entityId   String
  term       String

  @@unique([entityType, entityId, term])
  @@index([entityType, term, entityId])
}
