generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Initial catalog model. Authentication, playlists, plugin installs and migrations
// follow in their own milestones. Runtime database wiring is not implemented yet.
model Track {
  id         String   @id @default(cuid())
  title      String
  artist     String
  album      String?
  filePath   String   @unique
  durationMs Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
