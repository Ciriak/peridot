{
  "name": "@peridot/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "@peridot/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "prisma": "7.10.1"
  },
  "license": "Apache-2.0"
}
