{
  "name": "@peridot/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/dev.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm db:generate && tsx --test test/*.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:ensure": "tsx scripts/ensure-database-file.ts",
    "db:migrate": "pnpm db:ensure && prisma migrate dev",
    "db:migrate:deploy": "pnpm db:ensure && prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@peridot/contracts": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "music-metadata": "12.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0"
  },
  "license": "Apache-2.0"
}
