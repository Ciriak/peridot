{
  "name": "@peridot/server",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/dev.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm db:generate && tsx scripts/run-tests.ts",
    "perf:scan": "tsx scripts/benchmark-scan.ts",
    "db:validate": "prisma contract emit && tsx scripts/check-migrations.ts",
    "db:generate": "prisma contract emit",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:migrate:dev": "tsx scripts/migrate-database.ts --advance-ref db",
    "db:migration:plan": "prisma contract emit && prisma migration plan",
    "db:migration:check": "tsx scripts/check-migrations.ts",
    "db:reset": "tsx scripts/reset-database.ts && pnpm db:migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@peridot/contracts": "workspace:*",
    "@prisma/orm-sqlite": "8.0.0-rc.23",
    "croner": "10.0.1",
    "fastify": "5.12.8",
    "music-metadata": "12.3.5",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/ws": "^8.18.2",
    "prisma": "8.0.0-rc.33",
    "tsx": "^4.20.0"
  },
  "license": "Apache-2.0"
}
