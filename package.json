{
  "name": "peridot",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "dev": "pnpm db:update && pnpm --filter @peridot/contracts build && cross-env PORT=17431 PERIDOT_SERVE_WEB=false pnpm --parallel --filter @peridot/web --filter @peridot/server run dev",
    "dev:server": "pnpm db:update && pnpm --filter @peridot/contracts build && cross-env PORT=17431 PERIDOT_SERVE_WEB=false pnpm --filter @peridot/server run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@peridot/android",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "pnpm version:check && pnpm lint && pnpm format:check",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @peridot/server db:validate",
    "db:generate": "pnpm --filter @peridot/server db:generate",
    "db:update": "pnpm --filter @peridot/server db:update",
    "db:reset": "pnpm --filter @peridot/server db:reset",
    "desktop:dev": "pnpm --filter @peridot/desktop dev",
    "desktop:build": "pnpm --filter @peridot/desktop package",
    "android:sync": "pnpm --filter @peridot/android sync",
    "android:dev": "pnpm --filter @peridot/android dev",
    "android:open": "pnpm --filter @peridot/android open",
    "android:test": "pnpm --filter @peridot/android sync && pnpm --filter @peridot/android test",
    "android:instrument": "pnpm --filter @peridot/android sync && pnpm --filter @peridot/android instrument",
    "android:build": "pnpm --filter @peridot/android sync && pnpm --filter @peridot/android build",
    "android:bundle": "pnpm --filter @peridot/android sync && pnpm --filter @peridot/android bundle"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "^3.6.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.2"
  },
  "license": "Apache-2.0"
}
